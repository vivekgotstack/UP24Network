{$SITE_HOST} {
    encode zstd gzip
    @videoUpload path /api/video-upload/*
    request_body @videoUpload { max_size 262144000 }
    @otherRequests not path /api/video-upload/*
    request_body @otherRequests { max_size 13MB }
    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy frontend:3000 {
        # Only this public ingress supplies the client address to the private BFF.
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        header_up -Forwarded
    }
    log { output stdout }
}
